#!/usr/bin/env python3
"""Host-side client for the fsbroker prompt broker.

Usage:
  brokerctl ping
  brokerctl list
  brokerctl grant <always|timed:seconds> <absolute path>
  brokerctl revoke <absolute path>
  brokerctl clear
  brokerctl ask <op> <pid> <uid> <absolute path> [<path>...]
"""
import os
import socket
import sys

RUN_DIR = os.environ.get("FSBROKER_RUN_DIR") or os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "fsbroker",
)
SOCK = os.environ.get("FSBROKER_SOCK", os.path.join(RUN_DIR, "broker.sock"))

USAGE = __doc__


def send(line):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(SOCK)
    except OSError as e:
        sys.exit(f"brokerctl: cannot connect to {SOCK}: {e}")
    try:
        s.sendall(line.encode() + b"\n")
        chunks = []
        while True:
            b = s.recv(4096)
            if not b:
                break
            chunks.append(b)
        return b"".join(chunks).decode(errors="replace")
    finally:
        s.close()


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        return 0

    cmd = argv[0]
    if cmd in ("ping", "list", "clear"):
        line = cmd.upper()
    elif cmd == "grant":
        if len(argv) != 3 or not argv[2].startswith("/"):
            sys.exit("brokerctl: grant needs <always|timed:seconds> <absolute path>")
        line = f"GRANT {argv[1]} {argv[2]}"
    elif cmd == "revoke":
        if len(argv) != 2 or not argv[1].startswith("/"):
            sys.exit("brokerctl: revoke needs <absolute path>")
        line = f"REVOKE {argv[1]}"
    elif cmd == "ask":
        if len(argv) < 5:
            sys.exit("brokerctl: ask needs <op> <pid> <uid> <absolute path> [<path>...]")
        line = "ASK " + " ".join(argv[1:])
    else:
        sys.exit(f"brokerctl: unknown command {cmd!r}\n{USAGE}")

    out = send(line)
    sys.stdout.write(out)
    return 0 if out.startswith("OK") or out.startswith("ALLOW") else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
