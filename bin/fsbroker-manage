#!/usr/bin/env python3
"""fsbroker — GUI rule manager.

One window per running session, listing what the sandbox can see and what it
may change, with a Remove button on everything that is not from the config:
runtime mounts added by an approved access request, and the write allow/deny
rules the prompt creates. Config mounts are shown but not removable — only the
config file can take those away.

    fsbroker-manage [--run-dir <dir>]
"""
import argparse
import json
import os
import sys

import gi

gi.require_version("Gtk", "3.0")
# Gdk must be pinned too: the import list below is evaluated left to right, so
# without this it resolves to Gdk 4.0 and then clashes with Gtk 3.0.
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import fsbroker_proto as proto

# (key, heading) — the three panes, in order, each an equal share of the window.
SECTIONS = (
    ("mounts", "VISIBLE"),
    ("allows", "WRITE APPROVALS"),
    ("denies", "DENIALS"),
)


def default_icon():
    """A window with no icon of its own gets a placeholder in the task bar."""
    here = os.path.dirname(os.path.abspath(__file__))
    for name in ("fsbroker.png", "fsbroker.svg"):
        path = os.path.normpath(os.path.join(here, os.pardir, "icons", name))
        if os.path.exists(path):
            return path
    return None


def geometry_path():
    base = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
    return os.path.join(base, "fsbroker", "manage-window.json")


def load_geometry():
    try:
        with open(geometry_path()) as f:
            geo = json.load(f)
        return geo if isinstance(geo, dict) else {}
    except (OSError, ValueError):
        return {}


def save_geometry(window):
    """Remember where and how big the window is.

    `get_position()` is not the window's position — it is the position *you
    asked for* with `move()`, and stays (0, 0) when the window manager places
    the window itself. The frame extents are the real thing. Size comes from
    the client area, so restoring cannot grow the window by the decoration each
    time.
    """
    try:
        x, y = window.get_position()
        w, h = window.get_size()
        gdkwin = window.get_window()
        if gdkwin is not None:
            # Frame extents, because that is what `move()` takes: with a
            # decoration, move(250, 150) puts the frame at 150 and the client
            # 28px below it. Saving the client origin instead would drift by the
            # title bar on every run.
            frame = gdkwin.get_frame_extents()
            if frame.width and frame.height:
                x, y = frame.x, frame.y
        path = geometry_path()
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"x": int(x), "y": int(y), "w": int(w), "h": int(h)}, f)
        os.replace(tmp, path)
    except (OSError, ValueError):
        pass


class Manager(Gtk.Window):
    def __init__(self, run_dir):
        super().__init__(title=f"fsbroker rules — {run_dir}")
        self.run_dir = run_dir
        self.vroot_sock = os.path.join(run_dir, "vroot.sock")
        self.broker_sock = os.path.join(run_dir, "broker.sock")
        self.busy = False

        self.set_border_width(10)
        # Geometry is read on delete-event, while the window still exists: by
        # the time "destroy" runs, get_window() is already gone and its position
        # reads back as (0, 0), so saving there would store garbage.
        self.connect("delete-event", self.on_delete)
        self.connect("destroy", self.on_destroy)
        self._restore_geometry()

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.add(outer)

        self.header = Gtk.Label(xalign=0)
        self.header.set_selectable(True)
        outer.add(self.header)

        # Equal thirds, each scrolling on its own, all growing with the window.
        panes = Gtk.Grid(row_homogeneous=True)
        panes.set_vexpand(True)
        outer.add(panes)

        self.grids = {}
        for row, (key, heading) in enumerate(SECTIONS):
            frame = Gtk.Frame(label=heading)
            frame.set_vexpand(True)
            # A grid column is only as wide as its content unless a child asks
            # to expand, so without this the panes hug their text.
            frame.set_hexpand(True)
            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
            # Overlay scrollbars hide themselves, which reads as "clipped" when
            # a list is longer than its pane.
            scroller.set_overlay_scrolling(False)
            grid = Gtk.Grid(column_spacing=12, row_spacing=4, margin=6)
            grid.set_hexpand(True)
            scroller.add(grid)
            frame.add(scroller)
            panes.attach(frame, 0, row, 1, 1)
            self.grids[key] = grid

        buttons = Gtk.ButtonBox(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        buttons.set_layout(Gtk.ButtonBoxStyle.END)
        close = Gtk.Button(label="Close")
        # close(), not destroy(): it runs delete-event, which is where the
        # geometry is saved.
        close.connect("clicked", lambda *_: self.close())
        refresh = Gtk.Button(label="Refresh")
        refresh.connect("clicked", lambda *_: self.populate())
        buttons.add(close)
        buttons.add(refresh)
        outer.add(buttons)

        # Show first, then fill in: a socket that is slow to answer should not
        # hold the window off the screen.
        self.show_all()
        self.populate()
        # Runs once the main loop starts, by which time the window is mapped.
        if self._want_pos is not None:
            GLib.idle_add(self._place)

    # ---- geometry -----------------------------------------------------

    def _restore_geometry(self):
        geo = load_geometry()
        w, h = geo.get("w"), geo.get("h")
        if w and h:
            self.set_default_size(int(w), int(h))
        else:
            self.set_default_size(900, 600)
        x, y = geo.get("x"), geo.get("y")
        self._want_pos = (int(x), int(y)) if x is not None and y is not None else None

    def _place(self):
        """Move into place once the window is on screen.

        A window manager ignores a move for a window that is not mapped yet,
        which is why doing this before `show_all()` had no effect.
        """
        if self._want_pos is None:
            return False
        x, y = self._want_pos
        try:
            display = self.get_display()
            monitor = (display.get_monitor_at_point(x, y)
                       or display.get_primary_monitor() or display.get_monitor(0))
            area = monitor.get_geometry()
            # Keep it on a screen that currently exists, even if the saved one
            # is gone (a monitor was unplugged, the layout changed).
            x = min(max(x, area.x), area.x + max(0, area.width - 120))
            y = min(max(y, area.y), area.y + max(0, area.height - 120))
        except Exception:
            pass
        self.move(x, y)
        return False

    def on_delete(self, *_):
        save_geometry(self)
        return False            # carry on and destroy

    def on_destroy(self, *_):
        # Nothing to save here — see on_delete.
        # Several sessions means several windows; only the last one closes the
        # application.
        others = [w for w in Gtk.Window.list_toplevels()
                  if isinstance(w, Manager) and w is not self]
        if not others:
            Gtk.main_quit()

    # ---- rendering ----------------------------------------------------

    def note(self, grid, row, text):
        label = Gtk.Label(label=text, xalign=0)
        label.get_style_context().add_class("dim-label")
        grid.attach(label, 0, row, 4, 1)

    def row(self, grid, row, cells, remove=None, alt=False):
        """One row: all of it in a single box, so a background colour covers the
        whole line and you can see which Remove button goes with what. The
        columns are kept in step by size groups, since separate boxes do not
        align on their own."""
        line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        line.set_hexpand(True)
        if alt:
            line.get_style_context().add_class("alt-row")
        for col, text in enumerate(cells):
            label = Gtk.Label(label=text, xalign=0)
            label.set_selectable(True)
            self.sizes[col].add_widget(label)
            line.pack_start(label, False, False, 0)
        if remove is not None:
            kind, target = remove
            button = Gtk.Button(label="Remove")
            button.connect("clicked", lambda *_: self.on_remove(kind, target))
            line.pack_end(button, False, False, 0)
        grid.attach(line, 0, row, 1, 1)

    def clear(self, grid):
        for child in grid.get_children():
            grid.remove(child)

    def populate(self):
        for grid in self.grids.values():
            self.clear(grid)
        # Fresh per rebuild: keeps a row's columns in step with every other row,
        # which separate boxes would not do on their own.
        self.sizes = [Gtk.SizeGroup(mode=Gtk.SizeGroupMode.HORIZONTAL)
                      for _ in range(4)]

        mounts = proto.query(self.vroot_sock, "MOUNTS")
        daemon_rules = proto.query(self.vroot_sock, "LIST")
        broker_rules = proto.query(self.broker_sock, "LIST")

        daemon_up = mounts is not None
        broker_up = broker_rules is not None
        self.header.set_text(
            f"run dir: {self.run_dir}    "
            f"daemon: {'running' if daemon_up else 'not running'}    "
            f"broker: {'running' if broker_up else 'not running'}")

        # --- visible mounts ---
        grid = self.grids["mounts"]
        native = set(proto.native_mounts(self.run_dir))
        if not daemon_up:
            self.note(grid, 0, "(daemon not running — nothing is mounted)")
        else:
            shown = sorted(proto.parse_mounts(mounts), key=lambda r: r[2])
            listed = {r[2] for r in shown}
            for row, (access, source, vpath, host) in enumerate(shown):
                if vpath in native:
                    # Served by the kernel: visible, read-only, no rule applies.
                    self.row(grid, row, [vpath, access, "kernel"], None,
                             alt=(row % 2 == 1))
                    continue
                where = {"config": "config",
                         "permanent": "approved"}.get(source, "session request")
                note = "" if source == "config" else f"   (-> {host})"
                if source == "config":
                    remove = None
                elif source == "permanent":
                    remove = ("permanent", vpath)
                else:
                    remove = ("mount", vpath)
                self.row(grid, row, [vpath + note, access, where], remove,
                         alt=(row % 2 == 1))
            for extra, vpath in enumerate(sorted(native - listed)):
                self.row(grid, len(shown) + extra, [vpath, "ro", "kernel"], None,
                         alt=((len(shown) + extra) % 2 == 1))

        # --- rules, from both sources ---
        allows = []
        denies = []
        for source, lines in (("daemon", daemon_rules), ("broker", broker_rules)):
            if lines is None:
                continue
            for kind, scope, path in proto.parse_rules(lines):
                (allows if kind == "grant" else denies).append((source, scope, path))

        grid = self.grids["allows"]
        if not allows:
            self.note(grid, 0, "(none)")
        else:
            for row, (source, scope, path) in enumerate(
                    sorted(allows, key=lambda r: r[2])):
                self.row(grid, row, [path, scope, source],
                         ("daemon-rule" if source == "daemon" else "broker-rule", path),
                         alt=(row % 2 == 1))

        grid = self.grids["denies"]
        if not denies:
            self.note(grid, 0, "(none)")
        else:
            for row, (source, scope, path) in enumerate(
                    sorted(denies, key=lambda r: r[2])):
                self.row(grid, row, [path, scope, source],
                         ("daemon-rule" if source == "daemon" else "broker-rule", path),
                         alt=(row % 2 == 1))

        self.show_all()

    # ---- actions ------------------------------------------------------

    def on_remove(self, kind, target):
        if self.busy:            # a double click must not act twice
            return
        self.busy = True
        try:
            if kind == "mount":
                reply = proto.query(self.vroot_sock, f"DROP {target}")
            elif kind == "permanent":
                # Out of the sidecar, so it stays gone, and out of the live
                # table, so it goes away now.
                self.forget(target)
                reply = proto.query(self.vroot_sock, f"DROP {target}")
            elif kind == "daemon-rule":
                reply = proto.query(self.vroot_sock, f"REVOKE {target}")
            else:
                reply = proto.query(self.broker_sock, f"REVOKE {target}")

            if reply is None:
                self.error(f"no answer from the socket for {target}")
            elif not reply[0].startswith("OK") and "not mapped" not in reply[0]:
                # "not mapped" means it was already gone, which is the state we
                # asked for; anything else is worth showing.
                self.error(reply[0])
        finally:
            self.busy = False
        self.populate()

    def forget(self, vpath):
        """Take one entry out of the sidecar of approved mounts.

        Only blocks naming this path are touched, and only in the sidecar — the
        hand-written config is never read or written — so a removal can never
        delete something the sandbox needs to start.
        """
        side = proto.approved_mounts(self.run_dir)
        if not side or not os.path.exists(side):
            return
        try:
            with open(side) as f:
                lines = f.readlines()
        except OSError as e:
            self.error(f"cannot read {side}: {e}")
            return

        def names_path(block):
            for line in block:
                key = line.split("=", 1)[0].strip() if "=" in line else ""
                if key in ("host", "virtual_path") and f'"{vpath}"' in line:
                    return True
            return False

        blocks, current = [], []
        for line in lines:
            if line.strip() == "[[mount]]":
                blocks.append(current)
                current = [line]
            else:
                current.append(line)
        blocks.append(current)

        try:
            tmp = side + ".tmp"
            with open(tmp, "w") as f:
                for block in blocks:
                    if not names_path(block):
                        f.writelines(block)
            os.replace(tmp, side)
        except OSError as e:
            self.error(f"cannot write {side}: {e}")

    def error(self, message):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True,
                                message_type=Gtk.MessageType.ERROR,
                                buttons=Gtk.ButtonsType.CLOSE, text=message)
        dlg.run()
        dlg.destroy()


def main():
    ap = argparse.ArgumentParser(description="fsbroker rule manager")
    ap.add_argument("--run-dir", default=None,
                    help="run directory (env FSBROKER_RUN_DIR). Default: every "
                         "mounted session, from the mount table")
    args = ap.parse_args()

    if args.run_dir:
        dirs = [args.run_dir]
    else:
        dirs = proto.discover_run_dirs() or [proto.default_run_dir()]

    icon = default_icon()
    if icon:
        try:
            Gtk.Window.set_default_icon_from_file(icon)
        except Exception as e:
            print(f"fsbroker-manage: could not load {icon}: {e}", file=sys.stderr)

    # Alternating row shading, so a Remove button is visibly tied to its row.
    # Translucent grey rather than a fixed colour, so it reads on light and dark
    # themes alike.
    provider = Gtk.CssProvider()
    provider.load_from_data(
        b".alt-row { background-color: rgba(127, 127, 127, 0.14); }")
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    windows = [Manager(d) for d in dirs]
    Gtk.main()
    return 0 if windows else 1


if __name__ == "__main__":
    sys.exit(main())
