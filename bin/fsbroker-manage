#!/usr/bin/env python3
"""fsbroker — GUI rule manager.

One window per running session, listing what the sandbox can see and what it
may change, with a Remove button on everything that is not from the config:
runtime mounts added by an approved access request, and the write allow/deny
rules the prompt creates. Config mounts are shown but not removable — only the
config file can take those away.

    fsbroker-manage [--run-dir <dir>]
"""
import argparse
import json
import os
import sys

import gi

gi.require_version("Gtk", "3.0")
# Gdk must be pinned too: the import list below is evaluated left to right, so
# without this it resolves to Gdk 4.0 and then clashes with Gtk 3.0.
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gtk

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import fsbroker_proto as proto

# (key, heading) — the three panes, in order, each an equal share of the window.
SECTIONS = (
    ("mounts", "VISIBLE"),
    ("allows", "WRITE APPROVALS"),
    ("denies", "DENIALS"),
)


def geometry_path():
    base = os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state"))
    return os.path.join(base, "fsbroker", "manage-window.json")


def load_geometry():
    try:
        with open(geometry_path()) as f:
            geo = json.load(f)
        return geo if isinstance(geo, dict) else {}
    except (OSError, ValueError):
        return {}


def save_geometry(window):
    try:
        x, y = window.get_position()
        w, h = window.get_size()
        path = geometry_path()
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"x": x, "y": y, "w": w, "h": h}, f)
        os.replace(tmp, path)
    except (OSError, ValueError):
        pass


class Manager(Gtk.Window):
    def __init__(self, run_dir):
        super().__init__(title=f"fsbroker rules — {run_dir}")
        self.run_dir = run_dir
        self.vroot_sock = os.path.join(run_dir, "vroot.sock")
        self.broker_sock = os.path.join(run_dir, "broker.sock")
        self.busy = False

        self.set_border_width(10)
        self.connect("destroy", self.on_destroy)
        self._restore_geometry()

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.add(outer)

        self.header = Gtk.Label(xalign=0)
        self.header.set_selectable(True)
        outer.add(self.header)

        # Equal thirds, each scrolling on its own, all growing with the window.
        panes = Gtk.Grid(row_homogeneous=True)
        panes.set_vexpand(True)
        outer.add(panes)

        self.grids = {}
        for row, (key, heading) in enumerate(SECTIONS):
            frame = Gtk.Frame(label=heading)
            frame.set_vexpand(True)
            # A grid column is only as wide as its content unless a child asks
            # to expand, so without this the panes hug their text.
            frame.set_hexpand(True)
            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
            # Overlay scrollbars hide themselves, which reads as "clipped" when
            # a list is longer than its pane.
            scroller.set_overlay_scrolling(False)
            grid = Gtk.Grid(column_spacing=12, row_spacing=4, margin=6)
            grid.set_hexpand(True)
            scroller.add(grid)
            frame.add(scroller)
            panes.attach(frame, 0, row, 1, 1)
            self.grids[key] = grid

        buttons = Gtk.ButtonBox(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        buttons.set_layout(Gtk.ButtonBoxStyle.END)
        close = Gtk.Button(label="Close")
        close.connect("clicked", lambda *_: self.destroy())
        refresh = Gtk.Button(label="Refresh")
        refresh.connect("clicked", lambda *_: self.populate())
        buttons.add(close)
        buttons.add(refresh)
        outer.add(buttons)

        self.populate()
        self.show_all()

    # ---- geometry -----------------------------------------------------

    def _restore_geometry(self):
        geo = load_geometry()
        w, h = geo.get("w"), geo.get("h")
        if w and h:
            self.set_default_size(int(w), int(h))
        else:
            self.set_default_size(900, 600)
        x, y = geo.get("x"), geo.get("y")
        if x is None or y is None:
            return
        try:
            display = Gdk.Display.get_default()
            monitor = (display.get_monitor_at_point(x, y)
                       or display.get_primary_monitor() or display.get_monitor(0))
            area = monitor.get_geometry()
            # Keep it on a screen that currently exists, even if the saved one
            # is gone (a monitor was unplugged, the layout changed).
            x = min(max(x, area.x), area.x + max(0, area.width - 120))
            y = min(max(y, area.y), area.y + max(0, area.height - 120))
            self.move(x, y)
        except Exception:
            pass

    def on_destroy(self, *_):
        save_geometry(self)
        # Several sessions means several windows; only the last one closes the
        # application.
        others = [w for w in Gtk.Window.list_toplevels()
                  if isinstance(w, Manager) and w is not self]
        if not others:
            Gtk.main_quit()

    # ---- rendering ----------------------------------------------------

    def note(self, grid, row, text):
        label = Gtk.Label(label=text, xalign=0)
        label.get_style_context().add_class("dim-label")
        grid.attach(label, 0, row, 4, 1)

    def row(self, grid, row, cells, remove=None):
        for col, text in enumerate(cells):
            label = Gtk.Label(label=text, xalign=0)
            label.set_selectable(True)
            grid.attach(label, col, row, 1, 1)
        if remove is not None:
            kind, target = remove
            button = Gtk.Button(label="Remove")
            button.connect("clicked", lambda *_: self.on_remove(kind, target))
            # Expand the button's cell so it takes the slack and the button sits
            # at the right edge, with the path left-aligned.
            cell = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
            cell.set_hexpand(True)
            cell.pack_end(button, False, False, 0)
            grid.attach(cell, len(cells), row, 1, 1)

    def clear(self, grid):
        for child in grid.get_children():
            grid.remove(child)

    def populate(self):
        for grid in self.grids.values():
            self.clear(grid)

        mounts = proto.query(self.vroot_sock, "MOUNTS")
        daemon_rules = proto.query(self.vroot_sock, "LIST")
        broker_rules = proto.query(self.broker_sock, "LIST")

        daemon_up = mounts is not None
        broker_up = broker_rules is not None
        self.header.set_text(
            f"run dir: {self.run_dir}    "
            f"daemon: {'running' if daemon_up else 'not running'}    "
            f"broker: {'running' if broker_up else 'not running'}")

        # --- visible mounts ---
        grid = self.grids["mounts"]
        if not daemon_up:
            self.note(grid, 0, "(daemon not running — nothing is mounted)")
        else:
            for row, (access, source, vpath, host) in enumerate(
                    sorted(proto.parse_mounts(mounts), key=lambda r: r[2])):
                where = "config" if source == "config" else "session request"
                note = "" if source == "config" else f"   (-> {host})"
                remove = None if source == "config" else ("mount", vpath)
                self.row(grid, row, [vpath + note, access, where], remove)

        # --- rules, from both sources ---
        allows = []
        denies = []
        for source, lines in (("daemon", daemon_rules), ("broker", broker_rules)):
            if lines is None:
                continue
            for kind, scope, path in proto.parse_rules(lines):
                (allows if kind == "grant" else denies).append((source, scope, path))

        grid = self.grids["allows"]
        if not allows:
            self.note(grid, 0, "(none)")
        else:
            for row, (source, scope, path) in enumerate(
                    sorted(allows, key=lambda r: r[2])):
                self.row(grid, row, [path, scope, source],
                         ("daemon-rule" if source == "daemon" else "broker-rule", path))

        grid = self.grids["denies"]
        if not denies:
            self.note(grid, 0, "(none)")
        else:
            for row, (source, scope, path) in enumerate(
                    sorted(denies, key=lambda r: r[2])):
                self.row(grid, row, [path, scope, source],
                         ("daemon-rule" if source == "daemon" else "broker-rule", path))

        self.show_all()

    # ---- actions ------------------------------------------------------

    def on_remove(self, kind, target):
        if self.busy:            # a double click must not act twice
            return
        self.busy = True
        try:
            if kind == "mount":
                reply = proto.query(self.vroot_sock, f"DROP {target}")
            elif kind == "daemon-rule":
                reply = proto.query(self.vroot_sock, f"REVOKE {target}")
            else:
                reply = proto.query(self.broker_sock, f"REVOKE {target}")

            if reply is None:
                self.error(f"no answer from the socket for {target}")
            elif not reply[0].startswith("OK") and "not mapped" not in reply[0]:
                # "not mapped" means it was already gone, which is the state we
                # asked for; anything else is worth showing.
                self.error(reply[0])
        finally:
            self.busy = False
        self.populate()

    def error(self, message):
        dlg = Gtk.MessageDialog(transient_for=self, modal=True,
                                message_type=Gtk.MessageType.ERROR,
                                buttons=Gtk.ButtonsType.CLOSE, text=message)
        dlg.run()
        dlg.destroy()


def main():
    ap = argparse.ArgumentParser(description="fsbroker rule manager")
    ap.add_argument("--run-dir", default=None,
                    help="run directory (env FSBROKER_RUN_DIR). Default: every "
                         "mounted session, from the mount table")
    args = ap.parse_args()

    if args.run_dir:
        dirs = [args.run_dir]
    else:
        dirs = proto.discover_run_dirs() or [proto.default_run_dir()]

    windows = [Manager(d) for d in dirs]
    Gtk.main()
    return 0 if windows else 1


if __name__ == "__main__":
    sys.exit(main())
