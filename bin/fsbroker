#!/usr/bin/env bash
# fsbroker — run a program inside a deny-by-default filesystem sandbox.
#
#   fsbroker [--config <file>] [--run-dir <dir>] [--home <dir>] <command> ...
#
# Commands:
#   build                 compile the daemon (cargo build --release)
#   mount                 start the virtual-root daemon
#   umount                stop the daemon
#   broker start|stop|status
#   shell                 start a shell inside the sandbox
#   run [--] <cmd> ...    run a command inside the sandbox
#   session [--] <cmd>    mount + broker + run, then tear down
#   root-shell [--] [cmd ...]  enter the running session as root (needs allow_other)
#   status                show what the agent can currently access
#   rules                 GUI to view and remove the non-config rules
#   approvals [cmd...]    the broker's remembered allow/deny rules (default: list)
#   paths                 print the resolved locations and exit
#   help
#
# Locations (all runtime/state lives outside this repository):
#   --run-dir / FSBROKER_RUN_DIR   default ${XDG_STATE_HOME:-~/.local/state}/fsbroker
#   --config  / FSBROKER_CONFIG    default ${XDG_CONFIG_HOME:-~/.config}/fsbroker/vroot.toml
#   --home    / FSBROKER_HOME      default <run-dir>/home
#
# The run directory holds: mount/ (the FUSE mount point), the *.sock files,
# *.pid, broker-state.json, audit.log, log/, home/ (the sandbox home), and the
# generated etc-overrides/ and placeholders/.
set -uo pipefail

SELF=$(readlink -f -- "${BASH_SOURCE[0]}")
REPO=$(cd -- "$(dirname -- "$SELF")/.." && pwd)

RUN_DIR=${FSBROKER_RUN_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/fsbroker}
CONFIG=${FSBROKER_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/fsbroker/vroot.toml}
HOME_HOST=${FSBROKER_HOME:-}

while [ $# -gt 0 ]; do
  case "$1" in
    --run-dir) RUN_DIR=${2:?--run-dir needs a directory}; shift 2 ;;
    --config)  CONFIG=${2:?--config needs a file}; shift 2 ;;
    --home)    HOME_HOST=${2:?--home needs a directory}; shift 2 ;;
    --help|-h) set -- help ;;
    --) shift; break ;;
    -*) echo "fsbroker: unknown option: $1" >&2; exit 2 ;;
    *) break ;;
  esac
done

HOME_HOST=${HOME_HOST:-$RUN_DIR/home}
MOUNT="$RUN_DIR/mount"
RESOLVED="$RUN_DIR/vroot.resolved.toml"
DAEMON="$REPO/vroot/target/release/vroot"
LOG_DIR="$RUN_DIR/log"

HOST_USER=${HOST_USER:-$(id -un)}
HOST_USER_HOME=$(getent passwd "$HOST_USER" | cut -d: -f6)
DISPLAY=${DISPLAY:-:0}
# The sandbox gets its own UTS namespace, but with the host's name: a different
# hostname makes X set WM_CLIENT_MACHINE to it, and the panel then treats the
# window as remote and refuses to match it to its icon. Override to restore a
# distinct sandbox hostname.
HOST_HOSTNAME=${FSBROKER_HOSTNAME:-$(hostname 2>/dev/null || echo opencode-sandbox)}

say()  { printf 'fsbroker: %s\n' "$*"; }
die()  { printf 'fsbroker: %s\n' "$*" >&2; exit 1; }

cmd=${1:-help}; shift || true

# --------------------------------------------------------------------------
# shared setup
# --------------------------------------------------------------------------

resolve_config() {
  [ -f "$CONFIG" ] || die "no config file at $CONFIG (copy config/vroot.example.toml)"
  # Expand the two placeholders into a concrete config the daemon reads.
  sed -e "s|\${run}|$RUN_DIR|g" -e "s|\${home}|$HOME_HOST|g" "$CONFIG" > "$RESOLVED"
}

prepare_run_dir() {
  mkdir -p "$RUN_DIR" "$MOUNT" "$HOME_HOST" "$LOG_DIR" \
           "$RUN_DIR/tmp" "$RUN_DIR/shm" "$RUN_DIR/user1000" \
           "$RUN_DIR/placeholders/proc" "$RUN_DIR/placeholders/dev" \
           "$RUN_DIR/placeholders/tmp" "$RUN_DIR/placeholders/run" \
           "$HOME_HOST/.local/bin"
  chmod 700 "$RUN_DIR/user1000"
  chmod 1777 "$RUN_DIR/tmp" "$RUN_DIR/shm"
}

# The handful of /etc files the sandbox must see differently from the host. The
# real /etc is mounted read-only (see the config) and these are bound over the
# top of it. Only identity and the sandbox user's home are overridden; anything
# else is the host's own file, so a curated copy cannot go stale (a missing
# /etc/alternatives, say, breaks every symlink chain into it).
make_etc_overrides() {
  local etc="$RUN_DIR/etc-overrides"
  rm -rf "$etc"; mkdir -p "$etc"
  local uid gid; uid=$(id -u "$HOST_USER"); gid=$(id -g "$HOST_USER")
  cat > "$etc/passwd" <<EOF
root:x:0:0:root:/root:/bin/bash
$HOST_USER:x:$uid:$gid:$HOST_USER:/home/agent:/bin/bash
EOF
  cat > "$etc/group" <<EOF
root:x:0:
$HOST_USER:x:$gid:
EOF
  printf '%s\n' "$HOST_HOSTNAME" > "$etc/hostname"
  cat > "$etc/hosts" <<EOF
127.0.0.1 localhost $HOST_HOSTNAME
::1 localhost ip6-localhost ip6-loopback
EOF
  printf '0123456789abcdef0123456789abcdef\n' > "$etc/machine-id"
}

# Host objects that must be the real thing, bound in after the virtual root.
# Sockets and device nodes cannot be served through FUSE at all — the kernel
# needs a real socket or device inode, so a relaying filesystem can only show
# the name (connect() through the vroot fails) — and they sit under /run and
# /dev, which are built here rather than mapped. This is the same treatment X11
# and the request socket already get.
default_passthroughs() {
  local xdg=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
  printf '%s\n' \
    "ro $xdg/pulse" \
    "ro $xdg/pipewire-0" \
    "ro $xdg/pipewire-0-manager" \
    "dev /dev/snd" \
    "ro /run/systemd/resolve/stub-resolv.conf" \
    "ro /run/systemd/resolve/resolv.conf"
}

# Extra pass-throughs from the config: `[[pass]]` with `host`, optional
# `dev = true` for device nodes. Parsed here because bwrap's arguments are built
# before the daemon ever sees the config.
config_passthroughs() {
  [ -f "$RESOLVED" ] || return 0
  python3 - "$RESOLVED" <<'PY'
import sys
try:
    import tomllib
except ImportError:
    sys.exit(0)
try:
    with open(sys.argv[1], "rb") as f:
        cfg = tomllib.load(f)
except (OSError, ValueError):
    sys.exit(0)
for entry in cfg.get("pass", []):
    host = entry.get("host")
    if host:
        print(("dev" if entry.get("dev") else "ro") + " " + host)
PY
}

ensure_daemon_built() {
  [ -x "$DAEMON" ] && return 0
  say "building the daemon (cargo build --release)"
  "${CARGO:-$HOME/.cargo/bin/cargo}" build --release --manifest-path "$REPO/vroot/Cargo.toml" \
    || die "build failed"
}

is_mounted() { mountpoint -q "$MOUNT"; }
mount_entry() { mount | grep -q " $MOUNT "; }

# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------

cmd_build() {
  "${CARGO:-$HOME/.cargo/bin/cargo}" build --release --manifest-path "$REPO/vroot/Cargo.toml"
}

cmd_mount() {
  ensure_daemon_built
  if is_mounted; then
    # Reusing a live mount is intentional (mount + session), but it means the
    # resolved config on disk is whatever the existing daemon was started with.
    # Config edits would then look applied while having no effect, so say so.
    if [ "$CONFIG" -nt "$RESOLVED" ]; then
      say "already mounted at $MOUNT, but $CONFIG changed since that mount"
      say "the running mount still uses the old config; to apply it: fsbroker umount (then start again)"
    else
      say "already mounted at $MOUNT"
    fi
    return 0
  fi
  if mount_entry; then fusermount3 -uz "$MOUNT" 2>/dev/null || umount -l "$MOUNT" 2>/dev/null || true; fi
  prepare_run_dir
  make_etc_overrides
  resolve_config
  # `allow_other` lets a different uid (root, via `fsbroker root-shell`) use the
  # mount. Unprivileged FUSE refuses that unless /etc/fuse.conf allows it, and
  # the mount then also becomes reachable by any local uid, so keep the run
  # directory private.
  if grep -qE '^[[:space:]]*allow_other[[:space:]]*=[[:space:]]*true' "$RESOLVED"; then
    grep -qE '^[[:space:]]*user_allow_other' /etc/fuse.conf 2>/dev/null \
      || die "allow_other = true needs 'user_allow_other' in /etc/fuse.conf (uncomment it as root)"
    chmod 700 "$RUN_DIR"
  fi
  say "mounting $MOUNT (run dir $RUN_DIR)"
  RUST_LOG=${RUST_LOG:-info} setsid nohup "$DAEMON" \
    --config "$RESOLVED" --run-dir "$RUN_DIR" --mount-point "$MOUNT" \
    >>"$LOG_DIR/vroot.log" 2>&1 &
  echo $! > "$RUN_DIR/vroot.pid"
  local i
  for i in $(seq 1 50); do is_mounted && { say "mounted"; return 0; }; sleep 0.1; done
  die "mount did not appear; see $LOG_DIR/vroot.log"
}

cmd_umount() {
  if is_mounted || mount_entry; then
    fusermount3 -uz "$MOUNT" 2>/dev/null || umount -l "$MOUNT" 2>/dev/null || true
  fi
  if [ -f "$RUN_DIR/vroot.pid" ]; then
    kill "$(cat "$RUN_DIR/vroot.pid")" 2>/dev/null || true
    rm -f "$RUN_DIR/vroot.pid"
  fi
  rm -f "$RUN_DIR/sandbox.pid"
  say "unmounted $MOUNT"
}

broker_running() { [ -f "$RUN_DIR/broker.pid" ] && kill -0 "$(cat "$RUN_DIR/broker.pid")" 2>/dev/null; }

cmd_broker() {
  local sub=${1:-status}
  case "$sub" in
    start)
      if broker_running; then say "broker already running"; return 0; fi
      shift || true
      setsid nohup python3 "$REPO/broker/broker.py" --run-dir "$RUN_DIR" "$@" \
        >>"$LOG_DIR/broker.log" 2>&1 &
      echo $! > "$RUN_DIR/broker.pid"
      say "broker started";;
    stop)
      if broker_running; then kill "$(cat "$RUN_DIR/broker.pid")" 2>/dev/null || true; fi
      rm -f "$RUN_DIR/broker.pid"; say "broker stopped";;
    status)
      if broker_running; then say "broker running"; else say "broker not running"; fi;;
    *) die "broker {start|stop|status}";;
  esac
}

cmd_status() { exec "$REPO/bin/fsbroker-status" --run-dir "$RUN_DIR"; }

# The GUI view of the same thing, with a Remove on everything not from the
# config: runtime mounts and the broker's allow/deny rules.
cmd_rules() { exec "$REPO/bin/fsbroker-manage" --run-dir "$RUN_DIR" "$@"; }

# The broker's write approvals (the ones the prompt creates and remembers).
cmd_approvals() {
  exec "$REPO/broker/brokerctl" --run-dir "$RUN_DIR" "${@:-list}"
}

cmd_paths() {
  cat <<EOF
repo          $REPO
run dir       $RUN_DIR
config        $CONFIG
resolved      $RESOLVED
mount point   $MOUNT
sandbox home  $HOME_HOST
sockets       $RUN_DIR/{vroot,broker,request}.sock
state         $RUN_DIR/broker-state.json
audit         $RUN_DIR/audit.log
logs          $LOG_DIR
EOF
}

# bwrap arguments for entering the sandbox; fills BWRAP_ARGS.
sandbox_args() {
  is_mounted || die "the virtual root is not mounted; run: fsbroker mount"
  [ -S "$RUN_DIR/request.sock" ] || die "request socket missing; is the daemon running?"
  BWRAP_ARGS=(
    --unshare-all --share-net --die-with-parent --new-session
    --hostname "$HOST_HOSTNAME" --cap-drop ALL
    --bind "$MOUNT" /
    --proc /proc --dev /dev
    --bind "$RUN_DIR/tmp" /tmp
    --tmpfs /run
    --bind "$RUN_DIR/user1000" /run/user/1000
    --bind "$RUN_DIR/shm" /dev/shm
    --ro-bind "$RUN_DIR/request.sock" /run/user/1000/fsbroker-request.sock
    --ro-bind "$REPO/bin/fsbroker-request" /home/agent/.local/bin/fsbroker-request
    --ro-bind "/tmp/.X11-unix/X0" "/tmp/.X11-unix/X0"
    --ro-bind "$HOST_USER_HOME/.Xauthority" "/home/agent/.Xauthority"
    --setenv HOME /home/agent
    --setenv USER "$HOST_USER"
    --setenv LOGNAME "$HOST_USER"
    --setenv SHELL /bin/bash
    --setenv PATH "/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin"
    --setenv DISPLAY "$DISPLAY"
    --setenv XAUTHORITY /home/agent/.Xauthority
    --setenv XDG_SESSION_TYPE x11
    --setenv XDG_RUNTIME_DIR /run/user/1000
    --setenv LANG "${LANG:-C.UTF-8}"
    --chdir /home/agent
  )
  local v
  for v in OPENROUTER_API_KEY VLLM_API_KEY; do
    [ -n "${!v:-}" ] && BWRAP_ARGS+=(--setenv "$v" "${!v}")
  done

  # The real /etc is a vroot mount; these few files are bound over it. Guarded
  # on existence so a run dir mounted before this existed still works.
  local f
  for f in passwd group hostname hosts machine-id; do
    local src="$RUN_DIR/etc-overrides/$f"
    if [ -e "$src" ]; then
      BWRAP_ARGS+=(--ro-bind "$src" "/etc/$f")
    fi
  done

  # Real host objects that FUSE cannot proxy (sockets, devices).
  local kind path
  while read -r kind path; do
    [ -n "$path" ] || continue
    [ -e "$path" ] || continue
    if [ "$kind" = dev ]; then
      BWRAP_ARGS+=(--dev-bind "$path" "$path")
    else
      BWRAP_ARGS+=(--ro-bind "$path" "$path")
    fi
  done < <(default_passthroughs; config_passthroughs)
}

sandbox_exec() { sandbox_args; exec bwrap "${BWRAP_ARGS[@]}" -- "$@"; }
# Same, but as a child process, so the caller survives to run its cleanup.
# The pid is recorded so `root-shell` can find the sandbox. Note that bwrap
# itself stays in the host namespaces; the sandboxed program is its child.
sandbox_run() {
  sandbox_args
  bwrap "${BWRAP_ARGS[@]}" -- "$@" &
  local pid=$!
  echo "$pid" > "$RUN_DIR/sandbox.pid"
  local rc=0
  wait "$pid" || rc=$?
  rm -f "$RUN_DIR/sandbox.pid"
  return $rc
}

cmd_shell() { sandbox_exec "${SHELL:-/bin/bash}" "$@"; }
cmd_run()   { [ "${1:-}" = "--" ] && shift; [ $# -gt 0 ] || die "run needs a command"; sandbox_exec "$@"; }

# Mount, start the broker, run a command, then tear down again. This is the
# whole-session entry point a desktop launcher points at; the command is
# whatever program you want sandboxed (see run-opencode.sh).
cmd_session() {
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || die "session needs a command: session -- <cmd> [args]"
  local lock="$RUN_DIR/session.lock"
  if [ -f "$lock" ] && kill -0 "$(cat "$lock" 2>/dev/null)" 2>/dev/null; then
    die "a session is already running for $RUN_DIR (pid $(cat "$lock"))"
  fi
  # Global (not `local`): the EXIT trap runs after this function returns, so a
  # local would already be out of scope under `set -u`.
  SESSION_UP=0
  cleanup() {
    [ "${SESSION_UP:-0}" = 1 ] || return 0
    cmd_broker stop >/dev/null 2>&1 || true
    cmd_umount >/dev/null 2>&1 || true
    rm -f "$RUN_DIR/session.lock" "$RUN_DIR/sandbox.pid"
  }
  trap cleanup EXIT INT TERM
  mkdir -p "$RUN_DIR"
  echo $$ > "$lock"
  cmd_mount
  cmd_broker start
  local i
  for i in $(seq 1 50); do [ -S "$RUN_DIR/broker.sock" ] && break; sleep 0.1; done
  SESSION_UP=1
  sandbox_run "$@"
}

# Enter the running session's mount namespace as real root. Visibility is still
# the vroot: unmapped paths do not exist, read-only mounts still refuse writes,
# and write prompts still come from the broker. Privileges are the host's, so
# root can leave the namespace deliberately; it just cannot wander out by
# accident. Requires `allow_other = true` (see cmd_mount).
cmd_root_shell() {
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || set -- "${SHELL:-/bin/bash}"
  is_mounted || die "the virtual root is not mounted; run: fsbroker mount"
  [ -f "$RUN_DIR/sandbox.pid" ] \
    || die "no sandbox is running for $RUN_DIR (start one with: session)"
  grep -qE '^[[:space:]]*allow_other[[:space:]]*=[[:space:]]*true' "$RESOLVED" 2>/dev/null \
    || die "root-shell needs allow_other = true in the config (and 'user_allow_other' in /etc/fuse.conf)"
  local bpid apppid
  bpid=$(cat "$RUN_DIR/sandbox.pid" 2>/dev/null)
  kill -0 "$bpid" 2>/dev/null || die "the sandbox process $bpid is gone"
  apppid=$(pgrep -P "$bpid" 2>/dev/null | head -1)
  [ -n "$apppid" ] || die "cannot find the sandboxed process under pid $bpid"
  say "entering the sandbox as root (sandbox pid $apppid)"
  say "the virtual root still applies; leaving it would take deliberate effort"
  exec sudo nsenter -t "$apppid" -m -p -- "$@"
}

# The usage text is the comment block at the top of this file: print it up to
# the first line that is not a comment, so code can never leak into `help`.
cmd_help() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$SELF"; }

case "$cmd" in
  build)    cmd_build ;;
  mount)    cmd_mount ;;
  umount)   cmd_umount ;;
  broker)   cmd_broker "$@" ;;
  shell)    cmd_shell "$@" ;;
  run)      cmd_run "$@" ;;
  session)  cmd_session "$@" ;;
  root-shell) cmd_root_shell "$@" ;;
  status)   cmd_status ;;
  rules)    cmd_rules "$@" ;;
  approvals) cmd_approvals "$@" ;;
  paths|config) cmd_paths ;;
  help|"")  cmd_help ;;
  *) die "unknown command: $cmd (try: fsbroker help)" ;;
esac
