#!/usr/bin/env python3
"""One view of everything the sandboxed agent can currently access.

There are two independent things to know about any path:

  * can it be SEEN?      the daemon's live mount table
                         (permanent config from vroot.toml + this session's requests)
  * may it be CHANGED?   write approvals that let a mutation through with no prompt
                         (the prompt broker's grants + the daemon's operator grants)

Anything not in the mount table simply does not exist inside the sandbox (ENOENT).
This command prints both, so there is one place to look.
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import fsbroker_proto as proto


def section(title):
    print()
    print(title)
    print("-" * max(len(title), 40))


def report(run_dir):
    vroot_sock = os.path.join(run_dir, "vroot.sock")
    broker_sock = os.path.join(run_dir, "broker.sock")

    mounts = proto.query(vroot_sock, "MOUNTS")
    vgrants = proto.query(vroot_sock, "LIST")
    bgrants = proto.query(broker_sock, "LIST")

    # --- visibility -------------------------------------------------------
    section("VISIBLE — paths that exist inside the sandbox")
    native = set(proto.native_mounts(run_dir))
    if mounts is None:
        print("  (daemon not running — nothing is mounted)")
    else:
        rows = proto.parse_mounts(mounts)
        # config first, then this session's requests, each alphabetical
        rows.sort(key=lambda r: (r[1] != "config", r[2]))
        w = max([len(r[2]) for r in rows] + [len(p) for p in native] + [4])
        for access, source, vpath, host in rows:
            if vpath in native:
                print(f"  {vpath:<{w}}  {access:<2}  kernel")
                continue
            src = {"config": "config        ",
                   "permanent": "approved      "}.get(source, "session request")
            note = "" if source == "config" else f"   (-> {host})"
            print(f"  {vpath:<{w}}  {access:<2}  {src}{note}")
        # Bypassing the vroot means the daemon never hears about these paths.
        listed = {r[2] for r in rows}
        for p in sorted(native - listed):
            print(f"  {p:<{w}}  ro  kernel")

    # --- write approvals --------------------------------------------------
    section("WRITE APPROVALS — modifications allowed with no prompt")
    allows = []
    denies = []
    for source, lines in (("broker", bgrants), ("daemon", vgrants)):
        if lines is None:
            continue
        for kind, scope, path in proto.parse_rules(lines):
            (allows if kind == "grant" else denies).append((source, scope, path))

    if not allows:
        if vgrants is None and bgrants is None:
            print("  (neither daemon nor broker is running)")
        else:
            print("  (none — every write to a read-only path prompts)")
    else:
        for where, scope, path in sorted(allows, key=lambda g: (g[2], g[0])):
            print(f"  {where:<7} {scope:<12} {path}")

    section("DENIALS — modifications refused with no prompt")
    if not denies:
        print("  (none)")
    else:
        for where, scope, path in sorted(denies, key=lambda g: (g[2], g[0])):
            print(f"  {where:<7} {scope:<12} {path}")


def main():
    ap = argparse.ArgumentParser(description="show the sandbox's current access")
    ap.add_argument("--run-dir", default=None,
                    help="runtime directory (env FSBROKER_RUN_DIR). Default: "
                         "every mounted session, from the mount table")
    args = ap.parse_args()

    if args.run_dir:
        dirs = [args.run_dir]
    else:
        # No run dir and no FSBROKER_RUN_DIR: ask the mount table rather than
        # guessing a path. Falling back to the default keeps the "nothing is
        # running" answer useful.
        dirs = proto.discover_run_dirs() or [proto.default_run_dir()]

    print("fsbroker — current access"
          + (f"  ({len(dirs)} mounted sessions)" if len(dirs) > 1 else ""))
    for rd in dirs:
        print()
        print(f"run dir: {rd}")
        report(rd)

    print()
    print("Notes: config = permanent (vroot.toml). session request = approved this run.")
    print("       kernel = bound straight from the host: read-only, and never prompts.")
    print("       A rule covers its path and everything under it: a file path")
    print("       covers that file alone, a folder path covers its subtree.")
    print("       Anything not listed above is ENOENT to the agent.")


if __name__ == "__main__":
    sys.exit(main())
