# --- runtime state ----------------------------------------------------------
# Sockets, pid files, broker state/audit, logs, and the live FUSE mount point.
# /run/vroot is a mount; recursing into it is slow and wrong.
/run/

# --- build output -----------------------------------------------------------
/vroot/target/
**/target/

# --- node dependencies ------------------------------------------------------
**/node_modules/

# --- generated by prototype/phase2/setup.sh ---------------------------------
/prototype/phase2/etc-view/
/prototype/phase2/placeholders/

# --- sandbox runtime data ---------------------------------------------------
# Everything under demo/ is runtime, not source: the agent's home holds a copy
# of the opencode config (API keys), auth.json, its session database and
# caches; the demo project is scratch (and the sandbox agent has run git init
# inside it); log/ and run/ are screenshots and tmp mounts.
/prototype/phase1/demo/

# --- editor / OS cruft ------------------------------------------------------
*.swp
*.swo
.DS_Store
__pycache__/
