#!/usr/bin/env python3
"""One view of everything the sandboxed agent can currently access.

There are two independent things to know about any path:

  * can it be SEEN?      the daemon's live mount table
                         (permanent config from vroot.toml + this session's requests)
  * may it be CHANGED?   write approvals that let a mutation through with no prompt
                         (the prompt broker's grants + the daemon's operator grants)

Anything not in the mount table simply does not exist inside the sandbox (ENOENT).
This command prints both, so there is one place to look.
"""
import argparse
import os
import socket
import sys


def default_run_dir():
    d = os.environ.get("FSBROKER_RUN_DIR")
    return d or os.path.join(
        os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
        "fsbroker",
    )


def discover_run_dirs():
    """Run directories with a live vroot mount, newest first.

    Every mounted session appears in /proc/self/mounts as `vroot <dir>/mount
    fuse.vroot`, so the mount table names the run directories without having to
    guess where they are. A run directory that is mounted but whose daemon has
    died still shows up, which is the honest answer for it.
    """
    found = []
    try:
        with open("/proc/self/mounts", "rb") as f:
            lines = f.read().decode(errors="replace").splitlines()
    except OSError:
        return []
    for line in lines:
        parts = line.split(" ")
        if len(parts) < 3:
            continue
        source, mountpoint, fstype = parts[0], parts[1], parts[2]
        if source != "vroot" and not fstype.startswith("fuse.vroot"):
            continue
        # /proc escapes spaces and friends as octal.
        mountpoint = (mountpoint.replace("\\040", " ").replace("\\011", "\t")
                      .replace("\\012", "\n").replace("\\134", "\\"))
        rd = os.path.dirname(mountpoint.rstrip("/"))
        if rd and rd not in found:
            found.append(rd)
    return found


def query(sock, line, timeout=5):
    if not os.path.exists(sock):
        return None
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(sock)
        s.sendall(line.encode() + b"\n")
        chunks = []
        while True:
            b = s.recv(65536)
            if not b:
                break
            chunks.append(b)
    except OSError:
        return None
    finally:
        s.close()
    return b"".join(chunks).decode(errors="replace").splitlines()


def parse_mounts(lines):
    out = []
    for ln in lines[1:]:
        p = ln.split(" ", 4)
        if len(p) == 5 and p[0] == "mount":
            out.append(p[1:])  # access, source, vpath, host
    return out


def parse_grants(lines):
    """(kind, scope, path) for each `grant`/`deny` rule."""
    out = []
    for ln in lines[1:]:
        for kind in ("grant", "deny"):
            if ln.startswith(kind + " "):
                _, scope, path = ln.split(" ", 2)
                out.append((kind, scope, path))
                break
    return out


def section(title):
    print()
    print(title)
    print("-" * max(len(title), 40))


def report(run_dir):
    vroot_sock = os.path.join(run_dir, "vroot.sock")
    broker_sock = os.path.join(run_dir, "broker.sock")

    mounts = query(vroot_sock, "MOUNTS")
    vgrants = query(vroot_sock, "LIST")
    bgrants = query(broker_sock, "LIST")

    # --- visibility -------------------------------------------------------
    section("VISIBLE — paths that exist inside the sandbox")
    if mounts is None:
        print("  (daemon not running — nothing is mounted)")
    else:
        rows = parse_mounts(mounts)
        # config first, then this session's requests, each alphabetical
        rows.sort(key=lambda r: (r[1] != "config", r[2]))
        w = max((len(r[2]) for r in rows), default=4)
        for access, source, vpath, host in rows:
            src = "config        " if source == "config" else "session request"
            note = "" if source == "config" else f"   (-> {host})"
            print(f"  {vpath:<{w}}  {access:<2}  {src}{note}")

    # --- write approvals --------------------------------------------------
    section("WRITE APPROVALS — modifications allowed with no prompt")
    allows = []
    denies = []
    for source, lines in (("broker", bgrants), ("daemon", vgrants)):
        if lines is None:
            continue
        for kind, scope, path in parse_grants(lines):
            (allows if kind == "grant" else denies).append((source, scope, path))

    if not allows:
        if vgrants is None and bgrants is None:
            print("  (neither daemon nor broker is running)")
        else:
            print("  (none — every write to a read-only path prompts)")
    else:
        for where, scope, path in sorted(allows, key=lambda g: (g[2], g[0])):
            print(f"  {where:<7} {scope:<12} {path}")

    section("DENIALS — modifications refused with no prompt")
    if not denies:
        print("  (none)")
    else:
        for where, scope, path in sorted(denies, key=lambda g: (g[2], g[0])):
            print(f"  {where:<7} {scope:<12} {path}")


def main():
    ap = argparse.ArgumentParser(description="show the sandbox's current access")
    ap.add_argument("--run-dir", default=None,
                    help="runtime directory (env FSBROKER_RUN_DIR). Default: "
                         "every mounted session, from the mount table")
    args = ap.parse_args()

    if args.run_dir:
        dirs = [args.run_dir]
    else:
        # No run dir and no FSBROKER_RUN_DIR: ask the mount table rather than
        # guessing a path. Falling back to the default keeps the "nothing is
        # running" answer useful.
        dirs = discover_run_dirs() or [default_run_dir()]

    print("fsbroker — current access"
          + (f"  ({len(dirs)} mounted sessions)" if len(dirs) > 1 else ""))
    for rd in dirs:
        print()
        print(f"run dir: {rd}")
        report(rd)

    print()
    print("Notes: config = permanent (vroot.toml). session request = approved this run.")
    print("       A rule covers its path and everything under it: a file path")
    print("       covers that file alone, a folder path covers its subtree.")
    print("       Anything not listed above is ENOENT to the agent.")


if __name__ == "__main__":
    sys.exit(main())
